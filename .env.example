APP_NAME=KISAN X API
APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./kisanx.db
AUTO_CREATE_TABLES=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
NASA_POWER_TIMEOUT_SECONDS=25
NASA_POWER_CACHE_TTL_SECONDS=1800
NASA_POWER_RETRIES=2
# Required to use owner payment dashboard; keep private and use 6+ characters.
KISANX_OWNER_PIN=
